# EMPLOYEE360 AI - Environment Configuration Template
# Copy this file to .env before starting the backend

# Environment Mode
APP_ENV=development
DEBUG=True
PORT=8000
FRONTEND_URL=http://localhost:3000

# Security & Authentication
# Generate strong secrets in production: openssl rand -hex 32
SECRET_KEY=dev_secret_key_employee360_replace_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CANDIDATE_TOKEN_EXPIRE_HOURS=72

# Database Configuration
# Option 1: Zero-config local SQLite (instant setup for development)
DATABASE_URL=sqlite+aiosqlite:///./employee360.db

# Option 2: Local PostgreSQL with pgvector (recommended for production testing)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/employee360

# Model Provider Settings (Pluggable)
# Supported: "mock", "gemini", "ollama", "openai"
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Local Ollama settings (if using local Llama 3)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Speech-to-Text (STT) Settings
# Supported: "faster-whisper", "web-speech-fallback"
STT_PROVIDER=faster-whisper
WHISPER_MODEL_SIZE=base.en
WHISPER_DEVICE=cpu

# Text-to-Speech (TTS) Settings
# Supported: "edge-tts", "web-speech"
TTS_PROVIDER=edge-tts
TTS_VOICE=en-US-GuyNeural

# Local Storage Paths
MEDIA_STORAGE_PATH=./storage/media
SNAPSHOT_STORAGE_PATH=./storage/snapshots
TRANSCRIPT_STORAGE_PATH=./storage/transcripts
